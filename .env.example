# Supabase Auth, private Realtime, and Edge Functions serve multiplayer and
# movie lookup. Apply the migrations/functions described in README first.
# Copy this file to .env and fill in your public values for local dev.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Configure OMDB_API_KEY only as a Supabase Edge Function secret.
# Never put it in a VITE_ variable or a frontend build.

# No config needed: sub-genre suggestions (via Wikidata's genre data) work
# automatically alongside the OMDb lookup above -- no separate API key or
# signup required.
