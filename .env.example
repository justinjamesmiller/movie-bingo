# Supabase project used purely as a Realtime broadcast relay (no database
# tables needed). Create a free project at https://supabase.com/dashboard,
# then copy this file to .env and fill in your values for local dev.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
