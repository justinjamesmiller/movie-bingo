# Free Metered.ca TURN relay credentials (used as a fallback when direct
# WebRTC peer-to-peer connections fail across restrictive NATs/firewalls).
# Sign up free at https://dashboard.metered.ca/signup?tool=turnserver
# then copy this file to .env and fill in your values for local dev.
VITE_METERED_DOMAIN=yourappname.metered.live
VITE_METERED_API_KEY=your-api-key
