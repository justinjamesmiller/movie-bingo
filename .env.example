# Supabase project used purely as a Realtime broadcast relay (no database
# tables needed). Create a free project at https://supabase.com/dashboard,
# then copy this file to .env and fill in your values for local dev.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: enables the "look up a movie" feature (via OMDb/IMDb) on the host
# screen. Get a free key at https://www.omdbapi.com/apikey.aspx. If left
# unset, the movie-lookup UI just doesn't appear.
VITE_OMDB_API_KEY=your-omdb-api-key

# No config needed: sub-genre suggestions (via Wikidata's genre data) work
# automatically alongside the OMDb lookup above -- no separate API key or
# signup required.
VITE_TMDB_API_KEY=your-tmdb-api-key
